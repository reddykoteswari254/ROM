module rom(
    input [2:0] addr,
    output reg [7:0] data
);

always @(*) begin
    case(addr)
        3'b000: data = 8'b00000011;
        3'b001: data = 8'b00000110;
        3'b010: data = 8'b00001001;
        3'b011: data = 8'b00001100;
        3'b100: data = 8'b00001111;
        3'b101: data = 8'b00010010;
        3'b110: data = 8'b00010101;
        3'b111: data = 8'b00011000;
        default: data = 8'b00000000;
    endcase
end

endmodule